APP_NAME=DVARO
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Australia/Sydney
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_AU
APP_CURRENCY=AUD

# Super admin (platform owner) — seeded by SuperAdminRolesSeeder.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME="Platform Owner"

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database — PostgreSQL only (never MySQL)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dvaro
DB_USERNAME=postgres
DB_PASSWORD=

# Cache / Queue / Sessions — Redis (must be running for dev requests)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@dvaro.com.au"
MAIL_FROM_NAME="${APP_NAME}"

# SMS (tenant selects: ClickSend or Cellcast)
CLICKSEND_USERNAME=
CLICKSEND_API_KEY=
CELLCAST_API_KEY=

# WhatsApp (ClickSend via Meta BSP)
CLICKSEND_WHATSAPP_NUMBER=

# Email providers (tenant selects: Mailgun, Resend, SMTP)
MAILGUN_DOMAIN=
MAILGUN_SECRET=
RESEND_API_KEY=

# Payments (Stripe + PayPal)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# AI providers (tenant selects: Groq, Qwen, DeepSeek)
GROQ_API_KEY=
QWEN_API_KEY=
DEEPSEEK_API_KEY=

# Storage — app files (AWS S3-compatible, ap-southeast-2)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-2
AWS_BUCKET=dvaro-app
AWS_USE_PATH_STYLE_ENDPOINT=false

# Contabo Object Storage — backups (separate bucket)
BACKUP_DISK=s3
CONTABO_BACKUP_ENDPOINT=https://eu2.contabostorage.com
CONTABO_BACKUP_KEY=
CONTABO_BACKUP_SECRET=
CONTABO_BACKUP_BUCKET=dvaro-backups
CONTABO_BACKUP_REGION=eu2

# Reverb (future — real-time)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

VITE_APP_NAME="${APP_NAME}"
